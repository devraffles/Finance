{
  "name": "kwak-finance",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "dotenv -e .env -- pnpm --dir frontend dev",
    "build": "dotenv -e .env -- pnpm --dir frontend build",
    "start": "dotenv -e .env -- pnpm --dir frontend start",
    "lint": "pnpm --dir frontend lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter frontend typecheck && pnpm --filter @kwak-finance/backend typecheck",
    "test": "pnpm --filter @kwak-finance/backend test && pnpm --filter frontend test",
    "test:backend": "pnpm --filter @kwak-finance/backend test",
    "test:frontend": "pnpm --filter frontend test",
    "test:e2e": "node scripts/check-e2e-port.ts && playwright test",
    "test:coverage": "pnpm --filter @kwak-finance/backend run coverage && pnpm --filter frontend run coverage",
    "setup": "pnpm install && pnpm run db:generate && pnpm run db:migrate && pnpm run db:seed",
    "docker:up": "docker compose up --build --remove-orphans",
    "docker:down": "docker compose down --remove-orphans",
    "docker:reset": "docker compose down --volumes --remove-orphans && docker compose up --build",
    "docker:logs": "docker compose logs -f app",
    "docker:db:logs": "docker compose logs -f db",
    "docker:db:studio": "docker compose exec app pnpm run db:studio",
    "docker:shell": "docker compose exec app sh",
    "docker:seed": "docker compose exec app pnpm exec prisma db seed",
    "db:generate": "pnpm --filter @kwak-finance/backend exec prisma generate --schema prisma/schema.prisma",
    "db:migrate": "dotenv -e .env -- prisma migrate dev --schema backend/prisma/schema.prisma",
    "db:push": "dotenv -e .env -- prisma db push --schema backend/prisma/schema.prisma",
    "db:seed": "dotenv -e .env -- tsx backend/prisma/seed.ts",
    "db:studio": "dotenv -e .env -- prisma studio --schema backend/prisma/schema.prisma",
    "db:reset": "dotenv -e .env -- prisma migrate reset --schema backend/prisma/schema.prisma"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "dotenv-cli": "^11.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "prisma": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0"
  },
  "prisma": {
    "seed": "tsx backend/prisma/seed.ts"
  }
}

{
  "name": "@kwak-finance/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lib/auth": "./src/lib/auth.ts",
    "./lib/gemini": "./src/lib/gemini.ts",
    "./lib/prisma": "./src/lib/prisma.ts",
    "./schemas": "./src/schemas/index.ts",
    "./schemas/auth": "./src/schemas/auth.ts",
    "./services": "./src/services/index.ts",
    "./types/financas": "./src/types/financas.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "ai": "^7.0.0",
    "better-auth": "^1.6.11",
    "cpf-cnpj-validator": "^2.1.2",
    "dayjs": "^1.11.20",
    "pg": "^8.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/pg": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "prisma": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.7",
    "vitest-mock-extended": "^4.0.0"
  }
}
